# ---------------------------------------------------------------------
# Supabase (optional)
#
# Leave these unset and the app runs exactly as it always has: everything
# stays in the browser, no account, no sharing.
#
# Set them and the app gains accounts, shared trips and live sync.
# Copy this file to `.env.local` for local development, and add the same two
# variables to your Vercel project (Settings → Environment Variables).
#
# Both values are safe to expose in the browser — the anon key only grants
# what the row-level security policies in supabase/migrations allow.
# ---------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------
# עוזר הטיול — מודל שפה (אופציונלי)
#
# בלי המפתח הזה העוזר עובד כמו קודם: מנוע דטרמיניסטי שעונה מנתוני הטיול
# ומזהה תבניות בהדבקה. עם המפתח הוא מבין שפה חופשית.
#
# המפתח נשאר בשרת בלבד — הוא לא מתחיל ב-NEXT_PUBLIC_ ולכן לעולם לא מגיע
# לדפדפן. הבקשה עוברת דרך /api/assistant, שרץ ב-Vercel ולא בטלפון.
#
# מפתח נוצר ב-console.anthropic.com (דורש חשבון עם קרדיט).
# ---------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...

# ברירת המחדל היא claude-opus-5. אפשר לבחור מודל זול יותר, למשל
# claude-haiku-4-5, במחיר של תשובות פחות טובות בעברית ובהבנת בקשות מורכבות.
# ASSISTANT_MODEL=claude-opus-5
